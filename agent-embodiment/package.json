{
  "name": "agent-embodiment",
  "version": "0.23.0",
  "description": "Cross-session context analytics, session-level budget/prompt/tool controls, and optional agent scaffolds on top of DeepSeek Harness native compaction and tools.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node test/static.mjs && node test/metrics.mjs && node test/state.mjs && node test/scaffold.mjs",
    "test:integration": "node test/prepare-deps.mjs && node test/control.mjs && node test/smoke.mjs && node test/prompt-state.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./control": "./control.js",
    "./client": "./client.js",
    "./scaffold": "./scaffold.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "control.js",
    "state.js",
    "metrics.js",
    "scaffold.js",
    "client.js",
    "icon.svg",
    "locale/*.json",
    "dsh.bundle.patch.yml",
    "README.md",
    "LICENSE",
    "PERMISSIONS.md",
    "docs/EVIDENCE.md",
    "docs/IMPLEMENTATION.md",
    "docs/LIMITATIONS.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0 || 0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "context",
    "agent",
    "embodiment",
    "scaffold",
    "mcp",
    "token-budget"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiangweiliu/dsh-context.git",
    "directory": "agent-embodiment"
  },
  "dsh": {
    "manifestVersion": 1,
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0 || 0.2.1-rc.2 || 0.2.1-rc.3",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      },
      "profiles": [
        "web",
        "desktop"
      ]
    },
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
