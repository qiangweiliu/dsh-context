{
  "name": "dsh-context-guard",
  "version": "0.1.0",
  "description": "DSH 上下文长度管理最小插件：/ctx 显示当前会话 token 用量与预算，并在设置里提供只读面板",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "locale/*.json",
    "dsh.bundle.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "context",
    "token-budget"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
