{
  "name": "ctx-mon-and-con",
  "version": "0.14.3",
  "description": "DSH 上下文长度管理插件：/ctx 查看会话 token 用量与预算；可选的 control 半侧挂在 agent preset 内，按预算自动压缩",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./control": "./control.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "control.js",
    "state.js",
    "client.js",
    "icon.svg",
    "locale/*.json",
    "dsh.bundle.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "context",
    "token-budget"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiangweiliu/dsh-context.git",
    "directory": "plugin-skeleton"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
